QWidget#audioPage { background: #FFF9FB; }
QWidget#audioContent { background: #FFFFFF; border: 1px solid #F1DDE6; border-radius: 16px; }
QLabel#audioHeadingIcon { background: #FFE2EF; border-radius: 9px; }
QLabel#audioHeading { color: #28232B; font-size: 18pt; font-weight: 700; }
QTabWidget#audioTabs::pane { border: none; background: transparent; top: 8px; }
QTabWidget#audioTabs QTabBar { margin-bottom: 8px; }
QTabWidget#audioTabs QTabBar::tab {
    padding: 9px 15px; margin-right: 5px; border: 1px solid #F0DCE5;
    border-radius: 9px; background: #FFF8FB; color: #786F78;
}
QTabWidget#audioTabs QTabBar::tab:selected {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #FF4F9A,stop:1 #FF75AE);
    color: #FFFFFF; border-color: #FF4F9A;
}
QPlainTextEdit#audioPrompt { min-height: 170px; background: #FFFFFF; border-radius: 10px; }
QLabel#audioCharacterCount { color: #948B93; font-size: 8.5pt; }
QLabel#audioOptionLabel { color: #514951; font-size: 9.5pt; font-weight: 600; }
QPushButton#audioGenerate {
    min-height: 30px; color: #FFFFFF; font-size: 11pt; font-weight: 700;
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #FF4F9A,stop:0.55 #FF5CA1,stop:1 #F93B8C);
}
QPushButton#audioGenerate:hover { background: #FF6CAA; }
QFrame#audioResultPlayer { border: none; border-radius: 12px; background: #FFF7FA; }
QFrame#audioResultPlayer QLabel#musicPlayerTime { color: #817680; font-size: 8.5pt; }
QFrame#audioResultPlayer QPushButton {
    min-width: 28px; max-width: 28px; min-height: 28px; max-height: 28px;
    border: none; padding: 0; background: transparent;
}
QFrame#audioResultPlayer QPushButton#musicPlayButton {
    min-width: 42px; max-width: 42px; min-height: 42px; max-height: 42px;
    border-radius: 21px; background: #FF7DB4;
}
