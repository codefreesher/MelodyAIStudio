/* Responsive login form with a separate artwork pane. */
QWidget#loginPage { background: #FFF9FB; }
QWidget#loginContainer { background: transparent; }
QWidget#loginFormPanel { background: #FFF9FB; }

QPushButton[role="link"] {
    background: transparent; border: none; padding: 0; min-height: 0; min-width: 0;
    font-size: 10.5pt; font-weight: 600; color: #C65A83; text-align: left;
}
QPushButton[role="link"]:hover { color: {{focus}}; text-decoration: underline; }
QPushButton[role="link"]:pressed { color: {{pressed}}; }
QPushButton[role="link"]:disabled { color: {{disabled_text}}; }

QLabel#loginTitle { font-size: 26pt; font-weight: 800; color: {{text}}; }
QLabel#loginGreeting { font-size: 10.5pt; color: #777078; }
QLabel#loginMuted { font-size: 10.5pt; color: #777078; }
QLabel#loginOr { font-size: 9.5pt; color: {{muted}}; }

QLineEdit#loginEmailInput, QLineEdit#loginPasswordInput {
    min-height: 30px; padding: 11px 12px; border: 1px solid #E8DDE2; border-radius: 8px;
    background: #FFFFFF; font-size: 10.5pt;
}
QLineEdit#loginEmailInput:hover, QLineEdit#loginPasswordInput:hover { border-color: {{secondary}}; }
QLineEdit#loginEmailInput:focus, QLineEdit#loginPasswordInput:focus { border-color: {{focus}}; }

QCheckBox#loginRemember { font-size: 10.5pt; color: {{text}}; spacing: 6px; }

QPushButton#loginSubmit {
    min-height: 32px; padding: 11px 16px; border-radius: 8px; font-size: 11pt; font-weight: 600;
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 {{secondary}}, stop:1 {{primary}});
    color: #FFFFFF; border: none;
}
QPushButton#loginSubmit:hover { background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #FF7FB4, stop:1 #FF64A2); }
QPushButton#loginSubmit:pressed { background: {{pressed}}; }
QPushButton#loginSubmit:disabled { background: {{disabled}}; color: {{disabled_text}}; }

QFrame#loginDivider { background: #EEE3E8; border: none; }

QPushButton#loginGoogle {
    min-height: 30px; padding: 10px 14px; border-radius: 8px; border: 1px solid #E8DDE2;
    background: #FFFFFF; color: {{text}}; font-size: 10.5pt; font-weight: 600;
}
QPushButton#loginGoogle:hover { background: {{hover}}; border-color: {{secondary}}; }
QPushButton#loginGoogle:pressed { background: {{soft}}; }

QWidget#loginArtworkPanel { border: none; }

/* Reset global tool-button padding inside fields so action icons stay centered. */
QLineEdit#loginEmailInput QToolButton,
QLineEdit#loginPasswordInput QToolButton {
    background: transparent; border: none; padding: 0; margin: 0;
    min-width: 24px; min-height: 24px; icon-size: 22px;
}
QFrame[role="inlineMessage"], QFrame[role="inlineMessage"] QLabel {
    background: transparent; border: none; border-radius: 0;
    color: {{muted}};
}
QFrame[role="inlineMessage"] QLabel[kind="error"] {
    color: #D32F2F; font-weight: 600;
}
