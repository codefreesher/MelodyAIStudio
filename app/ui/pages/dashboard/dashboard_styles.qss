QWidget#dashboardPage { background: #FFF9FB; }
QLabel#dashboardGreeting { font-size: 20pt; font-weight: 700; color: #25212A; }
QLineEdit#dashboardSearch { min-height: 22px; border-radius: 10px; background: #FFFFFF; }
QWidget#dashboardBanner {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #FFF0F6,stop:0.5 #FDE7F0,stop:1 #FFF7FA);
    border: 1px solid #F5DCE6; border-radius: 18px;
}
QPushButton#dashboardActionCard {
    min-height: 148px; padding: 0; border: 1px solid #F1DFE6; border-radius: 16px; background: #FFFFFF;
}
QPushButton#dashboardActionCard[variant="music"] { background: #FFF1F7; }
QPushButton#dashboardActionCard[variant="lyric"] { background: #F1F8FF; }
QPushButton#dashboardActionCard[variant="audio"] { background: #EFFFF7; }
QPushButton#dashboardActionCard[variant="image"] { background: #FFF8EC; }
QPushButton#dashboardActionCard:hover { border-color: #FF8BBB; }
QPushButton#dashboardActionCard:pressed { border-color: #FF4F9A; }
QLabel#dashboardActionIcon {
    border-radius: 26px; background: rgba(255,255,255,180); font-size: 28pt; font-weight: 700;
}
QLabel#dashboardActionIcon[variant="music"] { color: #D92980; }
QLabel#dashboardActionIcon[variant="lyric"] { color: #3289D7; }
QLabel#dashboardActionIcon[variant="audio"] { color: #1AAA72; }
QLabel#dashboardActionIcon[variant="image"] { color: #D88527; }
QLabel#dashboardActionTitle { font-size: 13pt; font-weight: 700; color: #29242D; }
QLabel#dashboardActionDescription { font-size: 9.5pt; color: #827983; }
QLabel#dashboardSectionTitle { font-size: 14pt; font-weight: 700; color: #29242D; }
QPushButton#dashboardViewAll {
    min-height: 0; min-width: 0; padding: 4px 2px; border: none; background: transparent; color: #D84A82;
}
QPushButton#dashboardViewAll:hover { color: #FF3F91; text-decoration: underline; }
QPushButton#dashboardProjectCard {
    min-height: 160px; padding: 0; text-align: left; border: 1px solid #F1DFE6;
    border-radius: 13px; background: #FFFFFF;
}
QPushButton#dashboardProjectCard:hover { border-color: #FF8BBB; background: #FFFDFE; }
QLabel#dashboardProjectThumbnail { background: #FCEAF2; color: #D92980; font-size: 30pt; border-radius: 12px; }
QLabel#dashboardProjectTitle { font-size: 10.5pt; font-weight: 700; color: #29242D; }
QLabel#dashboardProjectMeta { font-size: 9pt; color: #827983; }
