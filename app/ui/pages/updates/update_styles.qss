QWidget#updatePage { background: #FFF9FB; }
QLabel#updateHeading { color: #29252A; font-size: 17pt; font-weight: 700; }

QFrame#updateCard { background: #FFFFFF; border: 1px solid #EEDDE5; border-radius: 14px; }

QLabel#updateAppName { color: #29252A; font-size: 13pt; font-weight: 700; }
QLabel#updateAppSubtitle { color: #81767D; font-size: 8.5pt; }
QLabel#updateBadge {
    background: #FFF0F6; color: #FF4F95; border: 1px solid #FFD2E4; border-radius: 8px;
    padding: 3px 10px; font-size: 8.5pt; font-weight: 700;
}

QLabel#updateVersionCaption { color: #81767D; font-size: 8.5pt; }
QLabel#updateVersionValue { color: #29252A; font-size: 15pt; font-weight: 700; }
QLabel#updateVersionValueLatest { color: #FF4F95; font-size: 15pt; font-weight: 700; }
QLabel#updateVersionArrow { color: #81767D; font-size: 13pt; }

QLabel#updateStatusText { font-size: 10pt; font-weight: 600; }
QLabel#updateStatusText[tone="success"] { color: #29B86B; }
QLabel#updateStatusText[tone="primary"] { color: #FF4F95; }
QLabel#updateStatusText[tone="muted"] { color: #81767D; font-weight: 500; font-style: italic; }
QLabel#updateStatusText[tone="text"] { color: #29252A; }
QLabel#updateCheckedAt { color: #81767D; font-size: 8pt; }

QLabel#updateNotesLabel { color: #29252A; font-size: 9.5pt; font-weight: 700; }
QLabel#releaseNoteItem { color: #514951; font-size: 9pt; }
QLabel#releaseNoteEmpty { color: #81767D; font-size: 9pt; font-style: italic; }
QLabel#updateSizeLabel { color: #81767D; font-size: 8.5pt; }

QProgressBar#updateProgressBar {
    min-height: 8px; max-height: 8px; border-radius: 4px; background: #FFF0F6; border: none;
}
QProgressBar#updateProgressBar::chunk { background: #FF4F95; border-radius: 4px; }
QLabel#updateProgressPercent { color: #29252A; font-size: 9pt; font-weight: 700; }
QLabel#updateProgressSize, QLabel#updateProgressSpeed { color: #81767D; font-size: 8.5pt; }

QLabel#updateErrorTitle { color: #E65B72; font-size: 10pt; font-weight: 700; }
QLabel#updateErrorMessage { color: #29252A; font-size: 9.5pt; }
QPushButton#updateErrorToggle {
    text-align: left; border: none; background: transparent; padding: 2px 0;
    color: #81767D; font-size: 8.5pt; font-weight: 600;
}
QPushButton#updateErrorToggle:hover { color: #FF4F95; }
QLabel#updateErrorDetail {
    color: #81767D; font-size: 8pt; background: #FFF0F6; border-radius: 6px; padding: 8px;
}

QPushButton#updatePrimaryButton {
    min-height: 24px; padding: 9px 18px; border-radius: 8px; border: none;
    background: #FF4F95; color: #FFFFFF; font-size: 10pt; font-weight: 700;
}
QPushButton#updatePrimaryButton:hover { background: #F43D88; }
QPushButton#updatePrimaryButton:pressed { background: #E0227A; }
QPushButton#updatePrimaryButton:disabled { background: #F6D3E4; color: #FFFFFF; }
